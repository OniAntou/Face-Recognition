<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.facedetection.controller.ViewController">

    <left>
        <VBox spacing="16" styleClass="sidebar">
            <Label text="Camera" styleClass="sidebar-section-title" />

            <VBox spacing="10" styleClass="control-group">
                <Label text="Camera source" styleClass="stat-label" />
                <ComboBox fx:id="cameraSelector" maxWidth="Infinity"
                          promptText="Select device" styleClass="combo-box" />
                <Button fx:id="cameraButton" onAction="#toggleCamera"
                        maxWidth="Infinity" text="Start Camera"
                        styleClass="btn-primary" />
                <Button fx:id="insertImageButton" onAction="#selectImage"
                        maxWidth="Infinity" text="Open image"
                        styleClass="btn-secondary" />
            </VBox>

            <Separator styleClass="card-separator" />

            <Label text="Processing options" styleClass="sidebar-section-title" />
            <VBox spacing="12" styleClass="control-group">
                <CheckBox fx:id="adaptiveExposureCheckBox"
                          onAction="#handleAdaptiveExposureToggle"
                          selected="true"
                          styleClass="toggle-chip"
                          text="Adaptive light" />
                <CheckBox fx:id="brightLightModeCheckBox"
                          onAction="#handleBrightLightModeToggle"
                          selected="true"
                          styleClass="toggle-chip"
                          text="Bright-light correction" />
                <CheckBox fx:id="genderRecognitionCheckBox"
                          onAction="#handleGenderRecognitionToggle"
                          selected="false"
                          styleClass="toggle-chip"
                          text="Show gender labels" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="8" styleClass="stat-card">
                <Label text="Status" styleClass="stat-label" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Region styleClass="status-dot-active" />
                    <Label fx:id="engineLabel" text="Engine: Idle" styleClass="stat-value" />
                </HBox>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox id="headerBar" alignment="CENTER_LEFT" spacing="24">
            <VBox alignment="CENTER_LEFT" spacing="4">
                <Label id="appTitle" text="Face Recognition" />
                <Label id="appSubtitle" text="Live camera and image review" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="3" styleClass="header-metric">
                <Label fx:id="fpsLabel" styleClass="stat-value" text="FPS: --" />
                <Label text="Performance" styleClass="stat-label" />
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox id="contentArea" spacing="18" alignment="CENTER">
            <padding>
                <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
            </padding>

            <VBox fx:id="sourceCard" HBox.hgrow="ALWAYS" alignment="TOP_CENTER"
                  spacing="12" styleClass="view-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Source image" styleClass="card-header" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Live" styleClass="status-caption" />
                </HBox>
                <StackPane fx:id="sourceViewport" VBox.vgrow="ALWAYS" styleClass="image-viewport">
                    <ImageView fx:id="originalImageView"
                               pickOnBounds="true" preserveRatio="true" smooth="true" />
                </StackPane>
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" alignment="TOP_CENTER"
                  spacing="12" styleClass="view-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Reviewed image" styleClass="card-header" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="exposureStatusLabel" text="Exposure: Ready" styleClass="meta-label" />
                </HBox>
                <StackPane fx:id="resultViewport" VBox.vgrow="ALWAYS" styleClass="image-viewport">
                    <ImageView fx:id="processedImageView"
                               pickOnBounds="true" preserveRatio="true" smooth="true" />
                </StackPane>
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox id="footerBar" alignment="CENTER_LEFT" spacing="10">
            <Region styleClass="status-dot-active" />
            <Label fx:id="statusLabel" id="statusLabel" text="System ready" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="v${project.version}" styleClass="meta-label" />
        </HBox>
    </bottom>

</BorderPane>
